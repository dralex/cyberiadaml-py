<?xml version="1.0" encoding="utf-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string" />
  <key id="dName" for="graph" attr.name="name" attr.type="string" />
  <key id="dName" for="node" attr.name="name" attr.type="string" />
  <key id="dStateMachine" for="graph" attr.name="stateMachine" attr.type="string" />
  <key id="dGeometry" for="node" attr.name="geometry" />
  <key id="dLabelGeometry" for="edge" attr.name="labelGeometry" />
  <key id="dNote" for="node" attr.name="note" attr.type="string" />
  <key id="dVertex" for="node" attr.name="vertex" attr.type="string" />
  <key id="dData" for="node" attr.name="data" attr.type="string" />
  <key id="dData" for="edge" attr.name="data" attr.type="string" />
  <key id="dColor" for="node" attr.name="color" attr.type="string" />
  <key id="dColor" for="edge" attr.name="color" attr.type="string" />
  <graph id="Ga" edgedefault="directed">
    <data key="dStateMachine" />
    <data key="dName">Ga</data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

platform/ ArduinoUno

platformVersion/ 1.0</data>
    </node>
    <node id="cTimer1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer1</data>
      <data key="dData">type/ Timer</data>
    </node>
    <node id="cQHsmSerial">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT QHsmSerial</data>
      <data key="dData">type/ QHsmSerial

baud/ 9600</data>
    </node>
    <node id="cCounter1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Counter1</data>
      <data key="dData">type/ Counter</data>
    </node>
    <node id="sfdmmeidqlauhjhyudvj">
      <data key="dName">ADD</data>
      <data key="dGeometry">
        <rect x="91" y="166.8125" width="450" height="95" />
      </data>
      <data key="dData">entry/
Timer1.start(2000);
Counter1.add(1);</data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="gnnygmdtipfahdwyczgs">
      <data key="dName">SUB</data>
      <data key="dGeometry">
        <rect x="612.1600000000016" y="528.0125000000015" width="450" height="95" />
      </data>
      <data key="dData">entry/
Timer1.start(2000);
Counter1.sub(1);</data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="gquxxfkcnnuxqupybpsl">
      <data key="dVertex">initial</data>
      <data key="dGeometry">
        <point x="-3" y="47.8125" />
      </data>
    </node>
    <node id="spjtslyxubbfmnokvavz">
      <data key="dVertex">choice</data>
      <data key="dGeometry">
        <rect x="275.28" y="401.8125" width="0" height="0" />
      </data>
    </node>
    <edge id="kqvealtjeeutftwpewon" source="gquxxfkcnnuxqupybpsl" target="sfdmmeidqlauhjhyudvj" />
    <edge id="zdwblhnaiygvwpxxnlqe" source="sfdmmeidqlauhjhyudvj" target="spjtslyxubbfmnokvavz">
      <data key="dData">Timer1.timeout/</data>
      <data key="dLabelGeometry">
        <point x="203.76" y="307.39249999999987" />
      </data>
      <data key="dColor">#FFFFFF</data>
    </edge>
    <edge id="ijyufugqtsnddxbsnsvt" source="spjtslyxubbfmnokvavz" target="gnnygmdtipfahdwyczgs">
      <data key="dData">[Counter1.value &gt;= 5]/
QHsmSerial::println("Больше или равно");</data>
      <data key="dLabelGeometry">
        <point x="254.55999999999992" y="596.8400000000004" />
      </data>
      <data key="dColor">#FFFFFF</data>
    </edge>
    <edge id="voonhvxsjkteszdltzfs" source="spjtslyxubbfmnokvavz" target="sfdmmeidqlauhjhyudvj">
      <data key="dData">[Counter1.value &lt;= 5]/
QHsmSerial::println("Меньше или равно");</data>
      <data key="dLabelGeometry">
        <point x="509.12000000000023" y="337.1200000000004" />
      </data>
      <data key="dColor">#FFFFFF</data>
    </edge>
    <edge id="blabla" source="spjtslyxubbfmnokvavz" target="sfdmmeidqlauhjhyudvj">
      <data key="dData">[else]/
QHsmSerial::println("Else");</data>
      <data key="dLabelGeometry">
        <point x="509.12000000000023" y="337.1200000000004" />
      </data>
      <data key="dColor">#FFFFFF</data>
    </edge>
  </graph>
