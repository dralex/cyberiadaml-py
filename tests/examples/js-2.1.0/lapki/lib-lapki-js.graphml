<?xml version="1.0" encoding="utf-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string" />
  <key id="dName" for="graph" attr.name="name" attr.type="string" />
  <key id="dName" for="node" attr.name="name" attr.type="string" />
  <key id="dStateMachine" for="graph" attr.name="stateMachine" attr.type="string" />
  <key id="dRegion" for="graph" attr.name="region" attr.type="string" />
  <key id="dGeometry" for="node" attr.name="geometry" />
  <key id="dNote" for="node" attr.name="note" attr.type="string" />
  <key id="dVertex" for="node" attr.name="vertex" attr.type="string" />
  <key id="dData" for="node" attr.name="data" attr.type="string" />
  <graph id="M1" edgedefault="directed">
    <data key="dStateMachine" />
    <data key="dName">Main</data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0</data>
    </node>
    <node id="n0">
      <data key="dName">Work</data>
      <data key="dGeometry">
        <rect x="0" y="0" width="400" height="300" />
      </data>
      <data key="dData">entry/
start()</data>
      <graph id="n0::region">
        <data key="dRegion" />
        <node id="n0::n1">
          <data key="dName">Step</data>
          <data key="dGeometry">
            <rect x="20" y="60" width="200" height="100" />
          </data>
        </node>
      </graph>
    </node>
    <node id="init">
      <data key="dVertex">initial</data>
      <data key="dGeometry">
        <point x="-60.5" y="20" />
      </data>
    </node>
    <node id="note">
      <data key="dNote">informal</data>
      <data key="dGeometry">
        <rect x="500" y="0" width="0" height="0" />
      </data>
      <data key="dData">A note.</data>
    </node>
    <edge id="init-n0" source="init" target="n0" />
  </graph>
  <graph id="M2" edgedefault="directed">
    <data key="dStateMachine" />
    <data key="dName">Second</data>
    <node id="m2s">
      <data key="dName">Idle</data>
      <data key="dGeometry">
        <rect x="0" y="0" width="200" height="100" />
      </data>
    </node>
  </graph>
</graphml>
