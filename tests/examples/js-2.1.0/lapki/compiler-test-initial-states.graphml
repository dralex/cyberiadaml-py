<?xml version="1.0" encoding="utf-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string" />
  <key id="dName" for="graph" attr.name="name" attr.type="string" />
  <key id="dName" for="node" attr.name="name" attr.type="string" />
  <key id="dStateMachine" for="graph" attr.name="stateMachine" attr.type="string" />
  <key id="dRegion" for="graph" attr.name="region" attr.type="string" />
  <key id="dGeometry" for="graph" attr.name="geometry" />
  <key id="dGeometry" for="node" attr.name="geometry" />
  <key id="dLabelGeometry" for="edge" attr.name="labelGeometry" />
  <key id="dNote" for="node" attr.name="note" attr.type="string" />
  <key id="dVertex" for="node" attr.name="vertex" attr.type="string" />
  <key id="dData" for="node" attr.name="data" attr.type="string" />
  <key id="dData" for="edge" attr.name="data" attr.type="string" />
  <key id="dColor" for="node" attr.name="color" attr.type="string" />
  <key id="dLapkiSchemePosition" for="node" attr.name="lapkiSchemePosition" attr.type="string" />
  <graph id="MS1Lamp2" edgedefault="directed">
    <data key="dStateMachine" />
    <data key="dName">Ведомый</data>
    <data key="dGeometry">
      <rect x="0" y="0" width="450" height="100" />
    </data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

platformVersion/ 1.0

lapkiVisual/ true

platform/ tjc-ms1-lmp-a3</data>
    </node>
    <node id="cTimer3">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer3</data>
      <data key="dData">type/ Timer

label/ миг

name/ ТаймерМигания</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cTimer4">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer4</data>
      <data key="dData">type/ Timer

label/ фаз

name/ ТаймерФазы</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cLED4">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT LED4</data>
      <data key="dData">type/ LED

pin/ 1

label/ кра

labelColor/ #ff0000

name/ Красный</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cLED5">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT LED5</data>
      <data key="dData">type/ LED

pin/ 2

labelColor/ #d4b00c

label/ ЖЕЛ

name/ Желтый</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cLED6">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT LED6</data>
      <data key="dData">type/ LED

pin/ 3

labelColor/ #06ff1a

label/ ЗЕЛ

name/ Зеленый</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cTimer5">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer5</data>
      <data key="dData">type/ Timer

label/ ИНИ

name/ ТаймерИнициализации</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cTimer6">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer6</data>
      <data key="dData">type/ Timer

name/ ТаймерОдногоМигания</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cSimpleBus1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT SimpleBus1</data>
      <data key="dData">type/ SimpleBus</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="zjejixbfnljnbxalwltt">
      <data key="dName">Внимание, скоро загорится красный</data>
      <data key="dGeometry">
        <rect x="904.7595654296872" y="1620.6501068115276" width="450" height="100" />
      </data>
      <data key="dData">entry/
LED4.off();
LED5.on();
LED6.off();
Timer4.start(1000);</data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="hsmpputdwnjmzdqxinim">
      <data key="dName">Движение запрещено</data>
      <data key="dGeometry">
        <rect x="1673.3095654296844" y="698.9701068115221" width="450" height="100" />
      </data>
      <data key="dData">entry/
Timer4.start(5000);
LED4.on();
LED5.off();
LED6.off();</data>
      <data key="dColor">#FFFFFF</data>
      <graph id="hsmpputdwnjmzdqxinim::region">
        <data key="dRegion" />
        <node id="dzollqabgoewhabzmipn">
          <data key="dName">Ожидание</data>
          <data key="dGeometry">
            <rect x="272.91999999999985" y="225.24000000000012" width="450" height="100" />
          </data>
          <data key="dData">entry/
Timer3.start(4000);</data>
          <data key="dColor">#FFFFFF</data>
        </node>
        <node id="vsmpqwtqfmuevclepulj">
          <data key="dName">Мигание</data>
          <data key="dGeometry">
            <rect x="235.88000000000073" y="466.4101068115212" width="450" height="100" />
          </data>
          <data key="dData">entry/
Timer6.start(200);</data>
          <data key="dColor">#FFFFFF</data>
          <graph id="vsmpqwtqfmuevclepulj::region">
            <data key="dRegion" />
            <node id="kbluidupkjmazlyheuya">
              <data key="dName">Включен</data>
              <data key="dGeometry">
                <rect x="115" y="135" width="450" height="100" />
              </data>
              <data key="dData">entry/
LED4.off();</data>
              <data key="dColor">#FFFFFF</data>
            </node>
            <node id="ahexalelxhoofddposct">
              <data key="dName">Выключен</data>
              <data key="dGeometry">
                <rect x="111.78043457031156" y="380.37983978271495" width="450" height="100" />
              </data>
              <data key="dData">entry/
LED4.on();</data>
              <data key="dColor">#FFFFFF</data>
            </node>
            <node id="zfzwdiytawsfztqfubwt">
              <data key="dVertex">initial</data>
              <data key="dGeometry">
                <point x="15" y="115" />
              </data>
            </node>
          </graph>
        </node>
        <node id="bhmiedzjveueqgwinwuz">
          <data key="dVertex">initial</data>
          <data key="dGeometry">
            <point x="73.28" y="184.55999999999997" />
          </data>
        </node>
      </graph>
    </node>
