  <graph id="MS1Lamp1" edgedefault="directed">
    <data key="dStateMachine" />
    <data key="dName">MS1Lamp1</data>
    <data key="dGeometry">
      <rect x="0" y="0" width="450" height="100" />
    </data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

platformVersion/ 1.0

lapkiVisual/ true

platform/ tjc-ms1-lmp-a3</data>
