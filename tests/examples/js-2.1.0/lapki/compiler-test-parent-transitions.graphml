    <node id="cLED1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT LED1</data>
      <data key="dData">type/ LED

pin/ 1</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cLED2">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT LED2</data>
      <data key="dData">type/ LED

pin/ 2</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cLED3">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT LED3</data>
      <data key="dData">type/ LED

pin/ 3</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cTimer1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer1</data>
      <data key="dData">type/ Timer</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="cTimer2">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT Timer2</data>
      <data key="dData">type/ Timer</data>
      <data key="dLapkiSchemePosition">x/ 30

y/ 30</data>
    </node>
    <node id="opffyasscvvpicxlhzet">
      <data key="dName">Начальное</data>
      <data key="dGeometry">
        <rect x="101.71478271484375" y="204.75005340576172" width="450" height="100" />
      </data>
      <data key="dData">entry/
LED1.on();
LED2.on();
LED3.on();
Timer1.start(2000);</data>
    </node>
    <node id="gkymncckchgzqwhfsyfd">
      <data key="dName">Родительское</data>
      <data key="dGeometry">
        <rect x="114.4295654296875" y="502.50010681152344" width="450" height="100" />
      </data>
      <data key="dData">entry/
LED1.off();
LED2.off();
LED3.off();
Timer2.start(1000);
Timer1.disable();</data>
      <graph id="gkymncckchgzqwhfsyfd::region">
